{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blossom-imgbed",
  "main": "deploy/worker/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "frontend-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "BLOSSOM_ENABLED": "true",
    "BLOSSOM_AUTH_MAX_AGE_SECONDS": "0",
    "BLOSSOM_AUTH_FUTURE_SKEW_SECONDS": "0",
    "BLOSSOM_LOGIN_CHALLENGE_TTL_SECONDS": "300"
  },
  "d1_databases": [
    {
      "binding": "img_d1",
      "database_name": "blossom-imgbed-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "img_r2",
      "bucket_name": "blossom-imgbed-storage"
    }
  ]
}

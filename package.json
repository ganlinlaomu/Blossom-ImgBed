{
  "name": "cloudflare-imgbed",
  "version": "2.7.6",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20 <23"
  },
  "workspaces": [
    "deploy/profiles/*"
  ],
  "scripts": {
    "build": "node deploy/worker/generate-routes.js",
    "db:init:cloudflare": "npx wrangler d1 execute img_d1 --remote --file=database/init.sql",
    "deploy": "npm run deploy:cloudflare",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "ci-test": "concurrently --kill-others \"npm start\" \"wait-on http://localhost:8080 && mocha\"",
    "ci-test:docker": "concurrently --kill-others \"npm run start:docker\" \"wait-on http://localhost:8080 && mocha\"",
    "test": "node --import ./deploy/server/register.mjs ./node_modules/mocha/bin/mocha \"test/**/*.test.js\"",
    "start": "npx wrangler pages dev ./frontend-dist --kv \"img_url\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data",
    "start:docker": "node --import ./deploy/server/register.mjs deploy/server/index.js",
    "deploy:worker": "npm run deploy:cloudflare"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6"
  },
  "cloudflare": {
    "bindings": {
      "BASIC_USER": {
        "description": "Administrator username for the ImgBed management console."
      },
      "BASIC_PASS": {
        "description": "Set a strong administrator password. It is stored as a Worker secret and must not be committed."
      },
      "img_d1": {
        "description": "D1 stores ImgBed metadata, Blossom ownership, the pubkey allowlist, login challenges, and sessions."
      },
      "img_r2": {
        "description": "R2 is the default provisioned object-storage backend. Other existing ImgBed storage providers can be configured after deployment."
      }
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mocha": "^8.1.3",
    "wait-on": "^7.2.0",
    "wrangler": "4.110.0"
  }
}
